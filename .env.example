# ローカル実行（docker compose / uvicorn）用の設定例。コピーして .env を作成する（.env はコミットしない）。
# 未設定・空の項目は既定値（docker compose ではモックサーバー）を使う。

# 独自LLMエンドポイント
LLM_URL=https://llm.example.internal/v1/generate
# APIキーを付けるヘッダー名と、その値（"Bearer xxx" など接続先の仕様どおりの形式で書く）
LLM_API_KEY_HEADER=Authorization
LLM_API_KEY=Bearer <APIキー>
# リクエスト本文のテンプレート（{{system}} と {{user}} がJSON文字列としてエスケープされて入る）
LLM_REQUEST_TEMPLATE={"system": "{{system}}", "prompt": "{{user}}"}
# 応答JSONから本文を取り出す JMESPath（例: choices[0].message.content）
LLM_RESPONSE_PATH=output
LLM_TIMEOUT=120

# Confluence（Authorization ヘッダーの値。形式は接続先の仕様に合わせる。Cloud の Basic 認証なら "Basic <base64(email:token)>"）
CONFLUENCE_URL=https://example.atlassian.net/wiki
CONFLUENCE_AUTH=Bearer <APIトークン>
CONFLUENCE_CQL=type=page

# Slack Incoming Webhook と、通知に載せるWeb画面のURL
SLACK_WEBHOOK_URL=
APP_URL=http://localhost:8000
